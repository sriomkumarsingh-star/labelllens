<!DOCTYPE html>
<html lang="en" class="bg-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            navy: '#0f2a54',
            success: '#15803d',
            warning: '#b45309',
            danger: '#dc2626',
          },
        },
      },
    }
  </script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; }
      .sheet { box-shadow: none !important; margin: 0 !important; border-radius: 0 !important; }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">

  <!-- Header -->
  <header class="no-print relative overflow-hidden bg-navy text-white">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
         style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:44px 44px;"></div>
    <div class="relative mx-auto flex max-w-4xl flex-col gap-6 px-5 py-8 md:px-8">
      <div class="flex items-center gap-4">
        <div class="flex size-12 items-center justify-center rounded-xl bg-white/10 text-2xl ring-1 ring-white/20">⚖️</div>
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight md:text-3xl">Legal Metrology Compliance Platform</h1>
          <p class="mt-1 flex items-center gap-2 text-sm text-white/70">
            <span class="rounded-md bg-white/10 px-2 py-0.5 font-mono text-xs">SIH26034</span>
            Department of Consumer Affairs
          </p>
        </div>
      </div>
      <nav class="flex flex-wrap gap-1.5">
        <a href="/" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-white/80 hover:bg-white/10">New Inspection</a>
        <a href="/repository" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-white/80 hover:bg-white/10">Rule Repository</a>
        <a href="/reports" class="rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-navy shadow-sm">View Reports</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-4xl px-5 py-8 md:px-8">
    <!-- Action bar -->
    <div class="no-print mb-5 flex flex-wrap items-center justify-between gap-3">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-navy hover:underline">← Back to inspections</a>
      <button onclick="window.print()" class="inline-flex items-center gap-2 rounded-xl bg-navy px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:brightness-125">
        🖨️ Print / Save as PDF
      </button>
    </div>

    <!-- Report sheet -->
    <article class="sheet overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="h-1.5 w-full <%= report.status === 'NON-COMPLIANT' ? 'bg-danger' : 'bg-success' %>"></div>
      <div class="p-6 md:p-10">

        <!-- Report header -->
        <div class="flex flex-col items-start justify-between gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-center">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-slate-400">Official Inspection Report</p>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight"><%= report.productName %></h2>
            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-slate-500">
              <span><span class="font-semibold text-slate-700">Report ID:</span> <span class="font-mono"><%= report.id %></span></span>
              <span><span class="font-semibold text-slate-700">Date:</span> <%= report.date %></span>
            </div>
          </div>
          
          <% if (report.status === 'NON-COMPLIANT') { %>
            <span class="inline-flex items-center gap-2 rounded-full border border-danger/30 bg-danger/10 px-3 py-1.5 text-sm font-bold text-danger">
              <span class="size-2 rounded-full bg-danger"></span> <%= report.status %>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3 py-1.5 text-sm font-bold text-success">
              <span class="size-2 rounded-full bg-success"></span> <%= report.status %>
            </span>
          <% } %>
        </div>

        <!-- Product details -->
        <section class="mt-8">
          <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Product Details</h3>
          <dl class="overflow-hidden rounded-xl border border-slate-200">
            <div class="flex flex-col gap-1 border-b border-slate-200 px-4 py-3 sm:flex-row sm:gap-4">
              <dt class="w-48 shrink-0 text-sm font-semibold text-slate-700">Product Name</dt>
              <dd class="text-sm text-slate-600"><%= report.productName %></dd>
            </div>
            <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:gap-4">
              <dt class="w-48 shrink-0 text-sm font-semibold text-slate-700">Inspection Source</dt>
              <dd class="text-sm text-slate-600"><%= report.source %></dd>
            </div>
          </dl>
        </section>

        <!-- Findings -->
        <section class="mt-8">
          <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Compliance Findings</h3>
          
          <% if (report.finding.isViolation) { %>
            <div class="rounded-xl border border-danger/30 bg-danger/5 p-5">
              <div class="flex items-start gap-3">
                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-danger/15 text-danger">⚠️</div>
                <div class="space-y-3">
                  <h4 class="flex flex-wrap items-center gap-2 font-bold text-danger">
                    <%= report.finding.title %>
                    <span class="rounded-md bg-danger/15 px-2 py-0.5 font-mono text-xs"><%= report.finding.rule %></span>
                  </h4>
                  <p class="text-sm text-slate-600"><span class="font-semibold text-slate-700">Rule Referenced:</span> <%= report.finding.reference %></p>
                  <div class="rounded-lg border border-slate-200 bg-white p-3">
                    <p class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400">AI Evidence
                      <span class="ml-auto inline-flex items-center gap-1 rounded-md bg-success/15 px-1.5 py-0.5 font-mono text-xs font-semibold text-success">✓ <%= report.finding.confidence %>%</span>
                    </p>
                    <p class="text-sm text-slate-600"><%= report.finding.description %></p>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="rounded-xl border border-success/30 bg-success/5 p-5">
              <div class="flex items-start gap-3">
                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-success/15 text-success">✓</div>
                <div class="space-y-3">
                  <h4 class="flex flex-wrap items-center gap-2 font-bold text-success">
                    Compliant Packaging
                  </h4>
                  <p class="text-sm text-slate-600">All mandatory declarations are present and clearly legible.</p>
                </div>
              </div>
            </div>
          <% } %>
        </section>

        <!-- Inspector notes -->
        <section class="mt-8">
          <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-slate-400">Inspector Notes</h3>
          <blockquote class="rounded-xl border-l-4 border-navy bg-slate-50 p-5">
            <p class="text-sm italic leading-relaxed text-slate-600">"<%= report.inspector.notes %>"</p>
            <footer class="mt-3 flex items-center gap-2 text-sm">
              <span class="flex size-7 items-center justify-center rounded-full bg-navy text-xs font-bold text-white"><%= report.inspector.initials %></span>
              <span class="font-semibold text-slate-700"><%= report.inspector.name %></span>
            </footer>
          </blockquote>
        </section>

        <!-- Footer -->
        <div class="mt-10 flex flex-col items-start justify-between gap-2 border-t border-slate-200 pt-5 text-xs text-slate-400 sm:flex-row sm:items-center">
          <p>Generated by the Legal Metrology Compliance Platform · SIH26034</p>
          <p class="font-mono"><%= report.id %></p>
        </div>

      </div>
    </article>
  </main>

</body>
</html>