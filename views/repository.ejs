<!DOCTYPE html>
<html lang="en" class="bg-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            navy: '#0f2a54',
            success: '#15803d',
            warning: '#b45309',
            danger: '#dc2626',
          },
        },
      },
    }
  </script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">

  <!-- Header -->
  <header class="relative overflow-hidden bg-navy text-white">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
         style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:44px 44px;"></div>
    <div class="relative mx-auto flex max-w-5xl flex-col gap-6 px-5 py-8 md:px-8">
      <div class="flex items-center gap-4">
        <div class="flex size-12 items-center justify-center rounded-xl bg-white/10 text-2xl ring-1 ring-white/20">⚖️</div>
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight md:text-3xl">Legal Metrology Compliance Platform</h1>
          <p class="mt-1 flex items-center gap-2 text-sm text-white/70">
            <span class="rounded-md bg-white/10 px-2 py-0.5 font-mono text-xs">SIH26034</span>
            Department of Consumer Affairs
          </p>
        </div>
      </div>
      <nav class="flex flex-wrap gap-1.5">
        <!-- Updated Navigation Links -->
        <a href="/" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-white/80 hover:bg-white/10">New Inspection</a>
        <a href="/repository" class="rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-navy shadow-sm">Rule Repository</a>
        <a href="/report" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-white/80 hover:bg-white/10">View Reports</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-5 py-8 md:px-8">
    <!-- Intro -->
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Version-Controlled Rule Engine Database</h2>
        <p class="mt-1 max-w-2xl text-sm text-slate-500">Machine-readable rules, exceptions, and amendments used to automatically evaluate AI-extracted declarations.</p>
      </div>
      <div class="relative w-full sm:w-64">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">🔎</span>
        <input id="search" type="search" placeholder="Search rules…"
          class="w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-9 pr-3 text-sm outline-none focus:ring-2 focus:ring-navy" />
      </div>
    </div>

    <!-- Stats -->
    <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="font-mono text-2xl font-bold text-navy"><%= stats.activeRules %></p><p class="text-xs text-slate-500">Active Rules</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="font-mono text-2xl font-bold text-success"><%= stats.machineReadable %></p><p class="text-xs text-slate-500">Machine-Readable</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="font-mono text-2xl font-bold text-warning"><%= stats.latestAmendment %></p><p class="text-xs text-slate-500">Latest Amendment</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="font-mono text-2xl font-bold text-navy"><%= stats.engineVersion %></p><p class="text-xs text-slate-500">Engine Version</p>
      </div>
    </div>

    <!-- Rules table (desktop) -->
    <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-100 text-xs font-semibold uppercase tracking-wide text-slate-500">
            <th class="px-4 py-3">Rule ID</th>
            <th class="px-4 py-3">Declaration Required</th>
            <th class="px-4 py-3">Condition / Applicability</th>
            <th class="px-4 py-3">Latest Amendment</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody id="rows" class="divide-y divide-slate-200 text-sm"></tbody>
      </table>
    </div>

    <!-- Rules cards (mobile) -->
    <div id="cards" class="grid gap-3 md:hidden"></div>

    <p id="empty" class="hidden py-10 text-center text-sm text-slate-400">No rules match your search.</p>
  </main>

  <script>
    // Injection of backend rules data into client-side JS
    const RULES = <%- JSON.stringify(rules) %>;
    
    const amendClass = { base: 'bg-slate-100 text-slate-600', amend: 'bg-warning/15 text-warning', new: 'bg-navy/10 text-navy' };

    function render(list) {
      const rows = document.getElementById('rows');
      const cards = document.getElementById('cards');
      rows.innerHTML = ''; cards.innerHTML = '';
      list.forEach(r => {
        rows.insertAdjacentHTML('beforeend', `
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3.5"><span class="rounded-md bg-navy/10 px-2 py-1 font-mono text-xs font-semibold text-navy">${r.id}</span></td>
            <td class="px-4 py-3.5 font-semibold text-slate-800">${r.decl}</td>
            <td class="px-4 py-3.5 text-slate-600">${r.cond}</td>
            <td class="px-4 py-3.5"><span class="rounded-md px-2 py-1 text-xs font-medium ${amendClass[r.tag]}">${r.amend}</span></td>
            <td class="px-4 py-3.5"><span class="inline-flex items-center gap-1.5 rounded-full bg-success/15 px-2.5 py-1 text-xs font-semibold text-success"><span class="size-1.5 rounded-full bg-success"></span>Active</span></td>
          </tr>`);
        cards.insertAdjacentHTML('beforeend', `
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="mb-2 flex items-center justify-between">
              <span class="rounded-md bg-navy/10 px-2 py-1 font-mono text-xs font-semibold text-navy">${r.id}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-success/15 px-2.5 py-1 text-xs font-semibold text-success"><span class="size-1.5 rounded-full bg-success"></span>Active</span>
            </div>
            <p class="font-semibold text-slate-800">${r.decl}</p>
            <p class="mt-1 text-sm text-slate-600">${r.cond}</p>
            <span class="mt-3 inline-block rounded-md px-2 py-1 text-xs font-medium ${amendClass[r.tag]}">${r.amend}</span>
          </div>`);
      });
      document.getElementById('empty').classList.toggle('hidden', list.length > 0);
    }

    document.getElementById('search').addEventListener('input', e => {
      const q = e.target.value.toLowerCase().trim();
      render(RULES.filter(r => (r.id + r.decl + r.cond + r.amend).toLowerCase().includes(q)));
    });

    // Initial render
    render(RULES);
  </script>
</body>
</html>